{# Full-page version of the category form (used when the modal is unavailable). #}
{% extends '@KimaiExpensesCommunity/expense/base.html.twig' %}

{% block expense_content %}
<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        {{ include('@KimaiExpensesCommunity/category/_form_fields.html.twig') }}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save category</button>
            <a class="btn btn-secondary" href="{{ path('kimai_expenses_community_category') }}">Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
