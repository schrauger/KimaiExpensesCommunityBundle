{% extends '@KimaiExpensesCommunity/expense/base.html.twig' %}

{% block expense_content %}
<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="row">
            <div class="col-md-6">{{ form_row(form.name) }}</div>
            <div class="col-md-3">{{ form_row(form.unit) }}</div>
            <div class="col-md-3">{{ form_row(form.defaultCost) }}</div>
        </div>

        {{ form_row(form.visible) }}
        {{ form_row(form.helpText) }}
        {{ form_row(form.description) }}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save category</button>
            <a class="btn btn-secondary" href="{{ path('kimai_expenses_community_category') }}">Cancel</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
