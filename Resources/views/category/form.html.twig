{% extends '@MileageExpense/expense/base.html.twig' %}

{% block expense_content %}
<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        {{ form_row(form.name) }}

        <div class="row">
            <div class="col-md-4">{{ form_row(form.unit) }}</div>
            <div class="col-md-4">{{ form_row(form.defaultCost) }}</div>
            <div class="col-md-4">{{ form_row(form.visible) }}</div>
        </div>

        {{ form_row(form.helpText) }}
        {{ form_row(form.description) }}

        <button type="submit" class="btn btn-primary">Save category</button>
        <a class="btn btn-secondary" href="{{ path('mileage_expense_category') }}">Cancel</a>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
