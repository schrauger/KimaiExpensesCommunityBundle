{% extends '@KimaiExpensesCommunity/expense/base.html.twig' %}

{% block expense_content %}
<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="{{ path('kimai_expenses_community_category_create') }}">
        <i class="fas fa-plus"></i> New category
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Unit</th>
                <th>Default cost</th>
                <th>Visible</th>
                <th>Description</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td><strong>{{ category.name }}</strong></td>
                    <td>{{ category.unit }}</td>
                    <td>{{ category.defaultCost|number_format(4, '.', ',') }}</td>
                    <td>
                        {% if category.visible %}
                            <span class="badge bg-green-lt">Yes</span>
                        {% else %}
                            <span class="badge bg-secondary-lt">No</span>
                        {% endif %}
                    </td>
                    <td>{{ category.description|default('—') }}</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('kimai_expenses_community_category_edit', {id: category.id}) }}">Edit</a>
                        <form method="post" action="{{ path('kimai_expenses_community_category_delete', {id: category.id}) }}" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">No categories found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
