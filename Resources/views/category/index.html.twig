{# Expense categories, laid out like Kimai's other admin lists. #}
{% extends '@KimaiExpensesCommunity/expense/base.html.twig' %}
{% import "macros/datatables.html.twig" as tables %}

{% block expense_actions %}
    <a class="btn modal-ajax-form" data-event="kimai.expenseUpdate"
       href="{{ path('kimai_expenses_community_category_create', {modal: 1}) }}">
        <i class="fas fa-plus"></i><span class="ms-1">Create</span>
    </a>
{% endblock %}

{% block expense_content %}
{% set table_name = 'expenses_community_category' %}
{# A plain string is the column's CSS class; an array can also carry a title (see ExpenseController::tableColumns). #}
{% set columns = {
    'name': 'alwaysVisible',
    'price': {'class': 'd-none d-sm-table-cell', 'title': 'Price'},
    'quantity': {'class': 'd-none d-md-table-cell', 'title': 'Quantity'},
    'description': 'd-none d-lg-table-cell',
    'visible': {'class': 'd-none d-md-table-cell', 'title': 'Visible'},
    'actions': 'actions alwaysVisible',
} %}

{{ tables.datatable_header(table_name, columns, null, {'reload': 'kimai.expenseUpdate', 'contextMenuId': ''}) }}

{% for category in categories %}
    <tr class="modal-ajax-form open-edit" data-event="kimai.expenseUpdate"
        data-href="{{ path('kimai_expenses_community_category_edit', {id: category.id, modal: 1}) }}">
        <td class="{{ tables.data_table_column_class(table_name, columns, 'name') }}">
            {{ include('@KimaiExpensesCommunity/expense/_dot.html.twig', {color: category.color}) }}
            <strong>{{ category.name }}</strong>
        </td>
        <td class="{{ tables.data_table_column_class(table_name, columns, 'price') }}">
            {% if category.priceEntered %}
                <span class="text-secondary">Entered on each expense</span>{% if category.defaultCost + 0 > 0 %} <span class="text-secondary">(prefill {{ category.defaultCost + 0 }})</span>{% endif %}
            {% else %}
                {{ category.defaultCost|number_format(4, '.', ',') }}{% if category.unit %} <span class="text-secondary">per {{ category.unit }}</span>{% endif %}
            {% endif %}
        </td>
        <td class="{{ tables.data_table_column_class(table_name, columns, 'quantity') }}">
            {% if category.askQuantity %}
                {{ category.unit ?: 'Quantity' }}
            {% else %}
                <span class="text-secondary">—</span>
            {% endif %}
        </td>
        <td class="{{ tables.data_table_column_class(table_name, columns, 'description') }}">{{ category.description|default('—') }}</td>
        <td class="{{ tables.data_table_column_class(table_name, columns, 'visible') }}">
            {% if category.visible %}
                <span class="badge bg-green-lt">Yes</span>
            {% else %}
                <span class="badge bg-secondary-lt">No</span>
            {% endif %}
        </td>
        <td class="{{ tables.data_table_column_class(table_name, columns, 'actions') }}">
            <div class="dropdown">
                <a class="btn-action text-secondary" href="#" data-bs-toggle="dropdown"
                   data-bs-boundary="viewport" aria-expanded="false" aria-label="Actions"><i class="fas fa-ellipsis"></i></a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item modal-ajax-form" data-event="kimai.expenseUpdate"
                       href="{{ path('kimai_expenses_community_category_edit', {id: category.id, modal: 1}) }}">Edit</a>
                    <div class="dropdown-divider"></div>
                    <form method="post" action="{{ path('kimai_expenses_community_category_delete', {id: category.id}) }}"
                          onsubmit="return confirm('Delete this category?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                        <button type="submit" class="dropdown-item text-danger">Delete</button>
                    </form>
                </div>
            </div>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="{{ columns|length }}" class="text-center py-5 text-muted">No categories found.</td>
    </tr>
{% endfor %}

{# Closes <tbody>, the table, its wrappers and the card (like Kimai's table footer without paging). #}
</tbody></table></div></div></div>

{{ tables.data_table_column_modal(table_name, columns) }}
{% endblock %}
