{% extends '@KimaiExpensesCommunity/expense/base.html.twig' %}

{% block expense_actions %}
    {% if can_export %}
        {# Same filters as the list, without paging. #}
        <a class="btn btn-outline-secondary"
           href="{{ path(list_route, app.request.query.all|merge({export: 'csv'})) }}">
            <i class="fas fa-download"></i> CSV
        </a>
    {% endif %}
    {% if is_granted('create_kimai_expenses_community') %}
        {# "modal-ajax-form" is Kimai's own class: it opens the link in Kimai's modal. #}
        <a class="btn btn-primary modal-ajax-form" data-event="kimai.expenseUpdate"
           href="{{ path('kimai_expenses_community_create', {returnUrl: app.request.requestUri}) }}">
            <i class="fas fa-plus"></i> New expense
        </a>
    {% endif %}
{% endblock %}

{% block expense_content %}
{% set colspan = 10 + (show_user ? 1 : 0) + (can_change_export ? 1 : 0) %}

<div class="card mb-3">
    <div class="card-body">
        {{ form_start(toolbar, {attr: {'data-expense-toolbar': '', 'class': 'row g-2 align-items-end'}}) }}
            <div class="col-md-3">{{ form_row(toolbar.searchTerm) }}</div>
            <div class="col-md-2">{{ form_row(toolbar.begin) }}</div>
            <div class="col-md-2">{{ form_row(toolbar.end) }}</div>
            {% if show_user %}
                <div class="col-md-3">{{ form_row(toolbar.user) }}</div>
            {% endif %}
            <div class="col-md-3">{{ form_row(toolbar.customer) }}</div>
            <div class="col-md-3">{{ form_row(toolbar.project) }}</div>
            <div class="col-md-3">{{ form_row(toolbar.activity) }}</div>
            <div class="col-md-3">{{ form_row(toolbar.category) }}</div>
            <div class="col-md-2">{{ form_row(toolbar.billable) }}</div>
            <div class="col-md-2">{{ form_row(toolbar.exported) }}</div>
            <div class="col-auto mb-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filter</button>
                {% if app.request.query.count > 0 %}
                    <a class="btn btn-link" href="{{ reset_url }}">Reset</a>
                {% endif %}
            </div>
        {{ form_end(toolbar, {render_rest: false}) }}
    </div>
</div>

{% if can_change_export %}
    {# Table rows reference this form with the HTML "form" attribute, so the
       delete forms in each row are not nested inside another form. #}
    <form id="expense-bulk" method="post" action="{{ path('kimai_expenses_community_export_state') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('expense-export-state') }}">
        <input type="hidden" name="returnUrl" value="{{ app.request.requestUri }}">
    </form>
{% endif %}

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
            <tr>
                {% if can_change_export %}
                    <th class="w-1"><input class="form-check-input" type="checkbox" data-expense-select-all aria-label="Select all"></th>
                {% endif %}
                <th>Date</th>
                <th>Category</th>
                <th>Customer</th>
                <th>Project</th>
                <th>Quantity</th>
                <th>Cost</th>
                <th>Total</th>
                <th>Billable</th>
                <th>Exported</th>
                {% if show_user %}<th>User</th>{% endif %}
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for expense in expenses %}
                <tr>
                    {% if can_change_export %}
                        <td><input class="form-check-input" type="checkbox" name="ids[]" value="{{ expense.id }}" form="expense-bulk" aria-label="Select expense"></td>
                    {% endif %}
                    <td class="text-nowrap">{{ expense.date|date('Y-m-d H:i', timezone) }}</td>
                    <td>
                        {% if expense.category.color %}
                            <span class="badge me-1" style="background-color: {{ expense.category.color|e('html_attr') }}; width: .75rem; height: .75rem; padding: 0;"></span>
                        {% endif %}
                        <strong>{{ expense.category.name }}</strong>
                        {% if expense.hasReceipt %}
                            <a href="{{ path('kimai_expenses_community_receipt_download', {id: expense.id}) }}"
                               target="_blank" rel="noopener" class="ms-1 text-secondary"
                               title="{{ expense.receiptOriginalName }}"><i class="fas fa-paperclip"></i></a>
                        {% endif %}
                        {% if expense.description %}
                            <div class="text-secondary small">{{ expense.description }}</div>
                        {% endif %}
                    </td>
                    <td>{{ expense.customer ? expense.customer.name : '—' }}</td>
                    <td>{{ expense.project ? expense.project.name : '—' }}</td>
                    <td>{{ expense.quantity|number_format(4, '.', ',') }} {{ expense.category.unit }}</td>
                    <td>{{ expense.cost|number_format(4, '.', ',') }}</td>
                    <td><strong>{{ expense.total|number_format(2, '.', ',') }}</strong></td>
                    <td>
                        {% if expense.billable %}
                            <span class="badge bg-green-lt">Yes</span>
                        {% else %}
                            <span class="badge bg-secondary-lt">No</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if expense.exported %}
                            <span class="badge bg-blue-lt">Yes</span>
                        {% else %}
                            <span class="badge bg-secondary-lt">No</span>
                        {% endif %}
                    </td>
                    {% if show_user %}
                        <td>{{ include('@KimaiExpensesCommunity/expense/_user.html.twig', {user: expense.user}) }}</td>
                    {% endif %}
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="{{ path('kimai_expenses_community_receipt', {id: expense.id}) }}">Receipt</a>
                        {% if is_granted('edit_kimai_expenses_community') %}
                            <a class="btn btn-sm btn-outline-primary modal-ajax-form" data-event="kimai.expenseUpdate"
                               href="{{ path('kimai_expenses_community_edit', {id: expense.id, returnUrl: app.request.requestUri}) }}">Edit</a>
                        {% endif %}
                        {% if is_granted('delete_kimai_expenses_community') %}
                            <form method="post" action="{{ path('kimai_expenses_community_delete', {id: expense.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this expense?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-expense-' ~ expense.id) }}">
                                <input type="hidden" name="returnUrl" value="{{ app.request.requestUri }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ colspan }}" class="text-center py-5 text-muted">No expenses found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if can_change_export and expenses|length > 0 %}
        <div class="card-footer d-flex align-items-center gap-2">
            <span class="text-secondary">With selected:</span>
            <button type="submit" form="expense-bulk" name="state" value="not_exported" class="btn btn-sm btn-outline-secondary">Mark as not exported</button>
            <button type="submit" form="expense-bulk" name="state" value="exported" class="btn btn-sm btn-outline-secondary">Mark as exported</button>
        </div>
    {% endif %}

    {# Totals cover ALL matching expenses, not just this page. #}
    <div class="card-footer d-flex align-items-center gap-3">
        <span class="text-secondary">{{ total_count }} expense(s)</span>
        <strong>Total: {{ sum_total|number_format(2, '.', ',') }}</strong>
        {{ include('@KimaiExpensesCommunity/expense/_pagination.html.twig') }}
    </div>
</div>
{% endblock %}
