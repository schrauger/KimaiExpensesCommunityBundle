{# Fields shared by the full-page form and the modal. Expects `form`. #}
{# Rows are NOT wrapped in grid columns: Kimai's form theme lays each row out with the label on the left. #}
{# Keep Extended settings open if one of its fields has a validation error. #}
{% set extendedHasErrors = form.cost.vars.errors|length > 0 or form.billable.vars.errors|length > 0 or form.exported.vars.errors|length > 0 %}

{{ form_errors(form) }}

{{ form_row(form.date) }}
{{ form_row(form.customer) }}
{{ form_row(form.project) }}
{{ form_row(form.activity) }}
{{ form_row(form.category) }}
{# Filled in by the form script from the chosen category's help text. #}
<div class="form-hint text-secondary small mb-3 d-none" data-expense-help></div>
{{ form_row(form.quantity) }}
{{ form_row(form.description) }}

{# By default an expense is billable, not exported, and priced by its category, so these stay tucked away. #}
<div class="accordion mt-3" id="expense-extended-accordion">
    <div class="accordion-item">
        <h2 class="accordion-header" id="expense-extended-heading">
            <button class="accordion-button{{ extendedHasErrors ? '' : ' collapsed' }}" type="button"
                    data-expense-toggle
                    data-bs-toggle="collapse" data-bs-target="#expense-extended"
                    aria-expanded="{{ extendedHasErrors ? 'true' : 'false' }}" aria-controls="expense-extended">
                Extended settings
            </button>
        </h2>
        <div id="expense-extended" data-expense-extended
             class="accordion-collapse collapse{{ extendedHasErrors ? ' show' : '' }}"
             aria-labelledby="expense-extended-heading">
            <div class="accordion-body">
                {{ form_row(form.cost) }}
                {{ form_row(form.billable) }}
                {{ form_row(form.exported) }}
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-3 mb-0">
    <strong>Calculated total:</strong>
    <span data-expense-total>0.00</span>
    <span data-expense-unit></span>
</div>
