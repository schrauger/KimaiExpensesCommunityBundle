{# Previous / next pager that keeps the active filters. Expects page, pages, list_route. #}
{% if pages > 1 %}
    <ul class="pagination m-0 ms-auto">
        <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
            <a class="page-link" href="{{ path(list_route, app.request.query.all|merge({page: page - 1})) }}">Previous</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page {{ page }} of {{ pages }}</span></li>
        <li class="page-item {{ page >= pages ? 'disabled' : '' }}">
            <a class="page-link" href="{{ path(list_route, app.request.query.all|merge({page: page + 1})) }}">Next</a>
        </li>
    </ul>
{% endif %}
