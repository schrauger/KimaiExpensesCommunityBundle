<script>
(function () {
    'use strict';

    // Finds a field by name in both naming styles: "expense[customer]"
    // (entity form) and "customer" (filter toolbar, empty block prefix).
    function pick(root, field) {
        return root.querySelector('[name="' + field + '"], [name$="[' + field + ']"]');
    }

    // "0.7000" -> "0.70", "1.0000" -> "1.00", "0.6725" -> "0.6725"
    function formatDecimal(value, minDecimals) {
        const text = String(value).trim();
        if (!/^-?\d+(\.\d+)?$/.test(text)) {
            return text;
        }
        const parts = text.split('.');
        let fraction = (parts[1] || '').replace(/0+$/, '');
        while (fraction.length < minDecimals) {
            fraction += '0';
        }
        return fraction ? parts[0] + '.' + fraction : parts[0];
    }

    // Kimai may replace a <select> with its own enhanced widget (Tom Select).
    // After changing the underlying <option> list, tell the widget to re-read it.
    function syncSelect(select, value) {
        select.value = value;
        const widget = select.tomselect;
        if (widget) {
            widget.clear(true);
            widget.clearOptions();
            widget.sync();
            widget.setValue(value, true);
        }
    }

    // ---- Customer -> Project -------------------------------------------------
    // Keeps every project option in memory and rebuilds the <select> with only
    // the selected customer's projects. With autoSelect, a customer that has
    // exactly one project selects it automatically, like Kimai's time tracking.
    function linkCustomerAndProject(customer, project, autoSelect) {
        if (!customer || !project) {
            return;
        }

        const all = Array.from(project.options);
        const placeholder = all.find(function (o) { return o.value === ''; }) || null;

        function projectsFor(customerId, alwaysKeep) {
            return all.filter(function (o) {
                if (o.value === '') {
                    return false;
                }
                return customerId === '' || o.dataset.customer === customerId || o.value === alwaysKeep;
            });
        }

        function render(options, selectedValue) {
            project.innerHTML = '';
            if (placeholder) {
                project.appendChild(placeholder);
            }
            options.forEach(function (o) { project.appendChild(o); });
            syncSelect(project, selectedValue);
        }

        // Initial load: narrow the list, but never drop the current project.
        const current = project.value;
        render(projectsFor(customer.value, current), current);

        customer.addEventListener('change', function () {
            const previous = project.value;
            const matches = projectsFor(customer.value, '');

            let next = matches.some(function (o) { return o.value === previous; }) ? previous : '';
            if (autoSelect && customer.value !== '' && matches.length === 1) {
                next = matches[0].value;
            }

            render(matches, next);

            if (project.value !== previous) {
                project.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    }

    // ---- Expense form (full page and Kimai modal) ----------------------------
    function initExpenseForm(form) {
        if (form.dataset.expenseReady) {
            return;
        }
        form.dataset.expenseReady = '1';

        const customer = pick(form, 'customer');
        const project = pick(form, 'project');
        const category = pick(form, 'category');
        const quantity = pick(form, 'quantity');
        const cost = pick(form, 'cost');
        const total = form.querySelector('[data-expense-total]');
        const unitLabel = form.querySelector('[data-expense-unit]');
        const extended = form.querySelector('[data-expense-extended]');
        const extendedToggle = form.querySelector('[data-expense-toggle]');
        const canEditCost = !!cost && !cost.disabled;
        const description = pick(form, 'description');
        const help = form.querySelector('[data-expense-help]');
        let autoDescription = '';

        linkCustomerAndProject(customer, project, true);

        function selectedCategory() {
            return category ? category.options[category.selectedIndex] : null;
        }

        function updateRateFromCategory() {
            if (!category || !cost || !canEditCost) {
                return;
            }
            const option = selectedCategory();
            const rate = option ? option.dataset.defaultCost : null;
            if (rate !== null && rate !== undefined && rate !== '') {
                cost.value = formatDecimal(rate, 2);
            }
        }

        // Show the category's help text and, when the description is still empty
        // (or still holds the previous category's text), fill in its description.
        function updateCategoryHints(fillDescription) {
            const option = selectedCategory();
            const helpText = option && option.dataset.help ? option.dataset.help : '';
            if (help) {
                help.textContent = helpText;
                help.classList.toggle('d-none', helpText === '');
            }
            if (fillDescription && description && option) {
                const text = option.dataset.description || '';
                if (description.value.trim() === '' || description.value === autoDescription) {
                    description.value = text;
                    autoDescription = text;
                }
            }
        }

        function updateTotal() {
            const q = parseFloat((quantity && quantity.value) || '0');
            const c = parseFloat((cost && cost.value) || '0');
            const result = Number.isFinite(q * c) ? q * c : 0;
            if (total) {
                total.textContent = result.toFixed(2);
            }
            const option = selectedCategory();
            if (unitLabel) {
                unitLabel.textContent = option ? ' ' + (option.textContent || '') : '';
            }
        }

        // The cost field lives in a collapsed accordion. If the browser rejects
        // it (e.g. it was cleared), open the accordion so the message is visible.
        if (cost) {
            cost.addEventListener('invalid', function () {
                if (extended) { extended.classList.add('show'); }
                if (extendedToggle) {
                    extendedToggle.classList.remove('collapsed');
                    extendedToggle.setAttribute('aria-expanded', 'true');
                }
            });
            cost.addEventListener('input', updateTotal);
        }

        if (category) {
            category.addEventListener('change', function () {
                updateRateFromCategory();
                updateTotal();
                updateCategoryHints(true);
            });
        }
        if (quantity) {
            quantity.addEventListener('input', updateTotal);
        }

        updateTotal();
        updateCategoryHints(false);
    }

    // ---- Filter toolbar ------------------------------------------------------
    function initToolbar(form) {
        if (form.dataset.expenseReady) {
            return;
        }
        form.dataset.expenseReady = '1';
        linkCustomerAndProject(pick(form, 'customer'), pick(form, 'project'), false);
    }

    // ---- Select-all checkbox in the list -------------------------------------
    function initSelectAll(box) {
        if (box.dataset.expenseReady) {
            return;
        }
        box.dataset.expenseReady = '1';
        box.addEventListener('change', function () {
            document.querySelectorAll('input[name="ids[]"]').forEach(function (cb) {
                cb.checked = box.checked;
            });
        });
    }

    function initAll(root) {
        root.querySelectorAll('form[data-expense-form]').forEach(initExpenseForm);
        root.querySelectorAll('form[data-expense-toolbar]').forEach(initToolbar);
        root.querySelectorAll('[data-expense-select-all]').forEach(initSelectAll);
    }

    // Kimai's own modal inserts the form after the page has loaded, and swaps
    // it again after a validation error. Watch for new forms and initialise
    // them; initAll() skips anything that is already set up.
    let scheduled = false;
    new MutationObserver(function () {
        if (scheduled) {
            return;
        }
        scheduled = true;
        window.requestAnimationFrame(function () {
            scheduled = false;
            initAll(document);
        });
    }).observe(document.body, { childList: true, subtree: true });

    // Links with data-event="kimai.expenseUpdate" make Kimai fire this event
    // after a successful save in its modal. Reload so the list shows the change.
    document.addEventListener('kimai.expenseUpdate', function () {
        window.location.reload();
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { initAll(document); });
    } else {
        initAll(document);
    }
})();
</script>
