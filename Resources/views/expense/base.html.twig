{# Shared page frame. Kimai's base.html.twig supplies the header, menu, toasts and modal host. #}
{% extends 'base.html.twig' %}

{% block page_title %}{{ title|default('Expenses') }}{% endblock %}

{# Shown at the right of the page header (Create / Export). Pages fill "expense_actions". #}
{% block page_actions %}
    <div class="btn-list">{% block expense_actions %}{% endblock %}</div>
{% endblock %}

{# Shown below the page title (column chooser, filter and search). Pages fill "expense_toolbar". #}
{% block table_actions %}{% block expense_toolbar %}{% endblock %}{% endblock %}

{# Flash messages are NOT printed here: Kimai's base template already turns them into toasts. #}
{% block main %}
    {% block expense_content %}{% endblock %}
    {{ include('@KimaiExpensesCommunity/expense/_scripts.html.twig') }}
{% endblock %}
